# ==============================================================================
# OpenClaw PR Manager - Environment Configuration Template
# ==============================================================================
#
# SECURITY NOTICE
# ---------------
# 1. Copy this file to `.env` and fill in your own credentials.
# 2. NEVER commit `.env` (or any file containing real secrets) to version control.
#    The `.gitignore` already includes `.env`, but you must verify this before pushing.
# 3. All values below are placeholders. The application cannot use them for real
#    API calls until you replace them with credentials you supply.
# 4. Setting a value here does NOT mean the integration is connected or working.
#    Use the status-verification commands in README.md to check boolean flags only.
#
# ==============================================================================

# Application Settings
APP_ENV=development
APP_DEBUG=true
PORT=8000
HOST=0.0.0.0
API_BASE_URL=http://localhost:8000
DASHBOARD_BASE_URL=http://localhost:8501

# Synthetic example.com records are disabled by default. Never enable this
# against the Supabase database used for real contacts.
SEED_DEMO_DATA=false

# Comma-separated list of dashboard origins allowed to call FastAPI from a browser.
# Example for local Streamlit: http://localhost:8501,http://127.0.0.1:8501
# In production, restrict this to your actual dashboard domain(s) over HTTPS.
CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501

# ------------------------------------------------------------------------------
# Supabase Configuration
# ------------------------------------------------------------------------------
# Find these in your Supabase Project Settings -> API
# SUPABASE_URL should look like: https://<project-ref>.supabase.co
# SUPABASE_KEY is the anon/public key used by the application backend.
# SUPABASE_SERVICE_ROLE_KEY is optional and must never be exposed to browsers.
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-role-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ------------------------------------------------------------------------------
# AI Provider Configuration
# ------------------------------------------------------------------------------
# OpenAI (Used for embeddings text-embedding-3-small & premium GPT-4o pitch)
# Get a key from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# DeepSeek (Used for cost-effective bulk pitch generation)
# Get a key from https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# ------------------------------------------------------------------------------
# Gmail OAuth2 Configuration
# ------------------------------------------------------------------------------
# Google Cloud Console OAuth 2.0 Client Credentials
# These credentials belong to YOUR app/Google Cloud project. Each Gmail sender
# then authorizes that app separately from the dashboard.
# 1. Enable the Gmail API in Google Cloud Console.
# 2. Configure the OAuth consent screen.
# 3. Create OAuth 2.0 credentials (Web application type).
# 4. Add the exact redirect URI below to "Authorized redirect URIs".
#
# CRITICAL: The redirect URI must exactly match the FastAPI route:
#   /api/v1/auth/google/callback
# Mismatches will cause Google to reject the OAuth flow.
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# ------------------------------------------------------------------------------
# News Scraping API Keys (Optional - Google News RSS works without keys)
# ------------------------------------------------------------------------------
# NewsAPI.org: https://newsapi.org/register
NEWS_API_ORG_KEY=
# TheNewsAPI.com: https://www.thenewsapi.com/
THE_NEWS_API_KEY=

# ------------------------------------------------------------------------------
# Tracking & Follow-up
# ------------------------------------------------------------------------------
# Base URL for the 1x1 open-tracking pixel endpoint.
# The actual route implemented by FastAPI is:
#   {TRACKING_BASE_URL}/open/{tracking_token}
# For local development:
TRACKING_BASE_URL=http://localhost:8000/api/v1/outreach/track
# For production, this MUST be a publicly reachable HTTPS URL, e.g.:
# TRACKING_BASE_URL=https://api.yourdomain.com/api/v1/outreach/track
